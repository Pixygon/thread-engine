<!-- The Weavery — the package directory of Weft (thread://weft.pixygon.io).
     One pedestal per published package: what it exports, and the one command
     that fetches-and-verifies it. A directory of hashes, never an authority
     over content: every plaque's URL serves immutable, self-verifying bytes. -->
<world id="weavery" title="The Weavery"
       description="The package directory of Weft — verified, content-addressed libraries for the Thread. Every pedestal is one fetch away."
       sky="night">
  <spawn at="0 0 16" yaw="180"/>

  <room at="0 0 0" r="12" h="4" columns="16" gates="180">
    <sphere id="loom-light" at="0 3.6 0" scale="0.7 0.7 0.7" class="beacon"
            light="0.85 0.7 1 2.4 16"/>

    <quad id="welcome" at="0 1.8 -3.2" scale="5.2 2.4 1"
          text="THE WEAVERY\nPackages for a language where packages cannot lie.\nEvery definition is named by its hash: nothing here can be changed under you, nothing conflicts, and your own verifier decides what to trust.\nfetch → verify → link → weave."/>

    <!-- weft-form -->
    <cylinder at="-7 0.5 -3" scale="1.4 1.0 1.4" class="stone"/>
    <quad at="-7 2.1 -3" rot="0 35 0" scale="3.0 1.9 1"
          text="weft-form\nThe shape of things: lerp, ring, grid.\nThe seed of the Thread's three.js.\n\nweftpack fetch https://wpm.pixygon.io/packages/weft-form.weftpack.json"/>

    <!-- weft-motion -->
    <cylinder at="0 0.5 -7.6" scale="1.4 1.0 1.4" class="stone"/>
    <quad at="0 2.1 -7.6" scale="3.0 1.9 1"
          text="weft-motion\nThe shape of time: ease-in/out, smoothstep, osc, pingpong.\nCurves that make conjured things feel alive.\n\nweftpack fetch https://wpm.pixygon.io/packages/weft-motion.weftpack.json"/>

    <!-- weft-clock -->
    <cylinder at="7 0.5 -3" scale="1.4 1.0 1.4" class="stone"/>
    <quad at="7 2.1 -3" rot="0 -35 0" scale="3.0 1.9 1"
          text="weft-clock\nA living behavior, published: the Atrium's heartbeat, built on weft-form's ring.\nBind it with one attribute:\nweft-use='weft-clock.weftpack.json#clock'"/>

    <!-- How to publish -->
    <quad at="-5.5 1.8 5.5" rot="0 135 0" scale="4.2 2.3 1"
          text="PUBLISH A PACKAGE\n1. Build defs with the weft crate; Package::build names your exports.\n2. weftpack publish my-lib.weftpack.json — wpm verifies before it stores.\n3. Or serve the file anywhere yourself: a CDN, a repo, .well-known/weft/.\nThe registry is a shelf, never an authority.\nRegistry: wpm.pixygon.io · Spec: docs/spec/weft-pack-v0.1.md"/>

    <quad at="5.5 1.8 5.5" rot="0 -135 0" scale="4.2 2.3 1"
          text="CONSUME A PACKAGE\nIn markup: weft-use='URL#export' on any object.\nIn Rust: weft::pack::link — a set union of hashes.\nOn the CLI: weftpack fetch / show / link.\nLinking has no versions and no conflicts: the same bytes are the same hash, forever."/>

    <sphere at="9 2.4 3" scale="0.22 0.22 0.22" class="lamp" light="1 0.8 0.5 1.6 12"/>
    <sphere at="-9 2.4 3" scale="0.22 0.22 0.22" class="lamp" light="1 0.8 0.5 1.6 12"/>

    <portal to="thread://wiki.pixygon.io" at="0 1.4 10.6" rot="0 180 0"
            scale="2 2.8 0.2" label="The Encyclopedia Atrium"/>
  </room>
</world>
<style>
  room  { color: 0.2 0.19 0.26; floor-color: 0.14 0.13 0.19; accent-color: 0.6 0.45 0.85 }
  .stone  { color: 0.3 0.28 0.38; roughness: 0.6 }
  .beacon { color: 0.85 0.7 1; emissive: 0.8 }
  .lamp   { color: 1 0.85 0.6; emissive: 0.8 }
</style>
