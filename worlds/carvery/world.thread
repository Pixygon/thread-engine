<!-- The Carvery — the shape-language demo. Every mesh here is CARVED, not a
     primitive: signed-distance recipes (<shape>) that the browser meshes at
     load. An amphora lathed from six profile points, boulders melted from
     spheres, an archway cut by a lying-down cylinder. This is Chisel —
     modeling for agents — in one small yard. -->
<world id="carvery" title="The Carvery"
       description="A mason's yard where every mesh is a carved recipe — lathed amphorae, melted boulders, a cut stone arch. The Thread's shape language, on display."
       sky="dawn" presence="none">

  <spawn at="0 0 12" yaw="180"/>

  <plane id="ground" at="0 0 0" scale="40 1 40" color="0.24 0.22 0.19" roughness="0.95"/>

  <!-- An amphora: one lathe line. Radius/height pairs, base to lip. -->
  <shape name="amphora" resolution="56">
    <lathe profile="0 0, 0.32 0, 0.4 0.12, 0.24 0.3, 0.5 0.9, 0.34 1.5, 0.42 1.62, 0.3 1.66, 0 1.66"/>
  </shape>

  <!-- A boulder: three spheres melted together, flattened underneath. -->
  <shape name="boulder" resolution="44">
    <cut>
      <blend k="0.35">
        <sphere r="0.9" at="0 0.7 0"/>
        <sphere r="0.65" at="0.6 0.5 0.35"/>
        <sphere r="0.55" at="-0.5 0.45 -0.3"/>
      </blend>
      <box size="4 1 4" at="0 -0.4 0"/>
    </cut>
  </shape>

  <!-- A standing arch: a rounded slab, doorway cut by a z-long cylinder
       over a box — the shape a primitive kit simply cannot make. -->
  <shape name="arch" resolution="64">
    <cut>
      <box size="4.6 4.2 0.9" at="0 2.1 0" rounded="0.12"/>
      <cylinder r="1.5" h="2" axis="z" at="0 2.4 0"/>
      <box size="3 2.4 2" at="0 1.2 0"/>
    </cut>
  </shape>

  <!-- A carved bowl for the fire: a melted sphere pair, hollowed. -->
  <shape name="brazier" resolution="48">
    <cut>
      <blend k="0.2">
        <sphere r="0.55" at="0 0.5 0"/>
        <cylinder r="0.28" h="0.7" at="0 0.2 0"/>
      </blend>
      <sphere r="0.42" at="0 0.75 0"/>
    </cut>
  </shape>

  <!-- Materials: one tag each — the browser bakes albedo/normal/ORM locally. -->
  <texture name="granite" kind="voronoi" scale="6" seed="11"
           colors="0.42 0.42 0.44 | 0.55 0.53 0.5 | 0.36 0.36 0.4"
           rough="0.95 0.8" height="0.7" ao="0.55"/>
  <texture name="terracotta" kind="fbm" scale="5" octaves="5" seed="4"
           colors="0.5 0.27 0.16 | 0.68 0.42 0.26"
           rough="0.75 0.55" height="0.25" ao="0.2"/>
  <texture name="ashlar" kind="bricks" scale="4" seed="2"
           colors="0.35 0.33 0.31 | 0.66 0.62 0.56"
           rough="0.9 0.75" height="0.5" ao="0.5"/>
  <texture name="iron" kind="fbm" scale="7" octaves="4" seed="9"
           colors="0.2 0.19 0.22 | 0.35 0.33 0.36"
           rough="0.5 0.3" metal="0.9 1" height="0.15"/>

  <!-- The yard. -->
  <cylinder id="dais" at="0 0.06 0" scale="6.5 0.12 6.5" color="0.35 0.32 0.28" roughness="0.85" solid="false"/>

  <x shape="arch" id="gate" at="0 0 -8" texture="ashlar"/>

  <x shape="amphora" id="amphora-1" at="-2.2 0 1.2" scale="1.3 1.3 1.3" texture="terracotta"/>
  <x shape="amphora" id="amphora-2" at="2.4 0 0.6" scale="0.9 0.9 0.9" texture="terracotta"/>

  <ring n="5" r="10" start="25" face="none">
    <x shape="boulder" at="0 0 0" texture="granite"/>
  </ring>

  <x shape="brazier" id="fire" at="0 0 2.5" scale="1.4 1.4 1.4" texture="iron"
     light="1 0.55 0.25 1.8 9" solid="false"/>

  <ring n="3" r="6" start="70" face="none">
    <lamp at="0 0 0" h="2.3"/>
  </ring>

  <quad id="plaque" at="4 1.5 4.5" yaw="220" scale="2.3 1.7 1" text-size="0.05" solid="false"
        text="THE CARVERY\n\nNothing here is a primitive.\nThe amphorae are one lathed\nline each; the boulders are\nspheres melted together; the\narch is stone with a doorway\ncut clean out of it.\n\nEvery mesh is a recipe the\nbrowser carves on arrival.\n\nWalk the arch to [[thread://pixygon.io#entry|the Nexus]]."/>

  <portal id="to-nexus" at="0 1.4 -8.6" to="thread://pixygon.io#entry" label="The Nexus"/>
  <portal id="to-glade" at="-9 1.4 -6" to="thread://glade#entry" label="The Glade"/>
</world>
